{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "drash",
	"compatibility_date": "2026-04-06",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"vars": {
		"ROOT_USERNAME": "root"
	},
	"kv_namespaces": [
		{
			"binding": "GROUPS_KV",
			"id": "1da5461fddec4de595b6743153b41b9c"
		}
	]
}
